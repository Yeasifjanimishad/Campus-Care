# ==============================================================================
# CampusCare Backend Environment Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000

# Client & CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000

# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Authentication
JWT_SECRET=your-secure-jwt-secret-here

# Rate Limiting Configuration
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW_MS=900000
